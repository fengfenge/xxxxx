# ---------- 开发环境 ----------
[dev_kafka]
192.168.13.36  kafka_broker_id=1
192.168.13.37  kafka_broker_id=2
192.168.13.38  kafka_broker_id=3

[dev_kafka:vars]
env=development

# ---------- 测试环境 ----------
[test_kafka]
192.168.13.59  kafka_broker_id=1
192.168.13.60  kafka_broker_id=2
192.168.13.61  kafka_broker_id=3

[test_kafka:vars]
